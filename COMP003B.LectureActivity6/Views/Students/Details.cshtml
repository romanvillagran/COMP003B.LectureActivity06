@model COMP003B.LectureActivity6.Models.Student

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div>
    <h4>Students</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(Model => Model.Name)
        </dt>
        <dd class="col-sm-10">
              @Html.DisplayNameFor(Model => Model.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(Model => Model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(Model => Model.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(Model => Model.Age)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayNameFor(Model => Model.Age)
        </dd>
    </dl>
</div>

<div class="col-md-4">
    <h4>Courses</h4>
    <ul>
        @foreach (Course course in ViewBag.Courses)
        {
            <li>@course.Title</li>
        }
    </ul>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.StudentId">Edit</a>
    <a asp-action="Index">Back to list</a>
</div>